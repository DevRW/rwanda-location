{
  "name": "@devrw/rwanda-location",
  "version": "1.1.2",
  "description": "A comprehensive TypeScript library for querying Rwanda's administrative divisions (provinces, districts, sectors, cells, and villages)",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevRW/rwanda-location.git"
  },
  "homepage": "https://github.com/DevRW/rwanda-location#readme",
  "bugs": {
    "url": "https://github.com/DevRW/rwanda-location/issues"
  },
  "keywords": [
    "rwanda",
    "location",
    "provinces",
    "districts",
    "sectors",
    "cells",
    "villages",
    "administrative-divisions",
    "geography",
    "rwanda-data"
  ],
  "author": "Jacques Nyilinkindi <info@jnkindilogs.xyz>",
  "contributors": [
    "Theo Okafor <theo.okafor@yahoo.com>"
  ],
  "license": "MIT",
  "private": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.json && node scripts/minify-data.cjs",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pack": "node scripts/check-pack.cjs",
    "check:api": "node scripts/check-api.cjs",
    "compat": "node scripts/compat/run.cjs",
    "bench": "npm run build && node scripts/bench.cjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
